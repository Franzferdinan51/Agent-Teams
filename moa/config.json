        "aggregator": { "provider": "lmstudio", "model": "qwen3.6-35b-a3b-mtp" },
        "reference_temperature": 0.6,
        "aggregator_temperature": 0.4,
        "reference_max_tokens": 1024,
        "enabled": true
      },
      "coding": {
