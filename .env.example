# Agent-Teams v2.3.0 — environment configuration
# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. NEVER commit real keys. All values below are placeholders.

# ─── LM Studio (local inference) ─────────────────────────────────
# Base URL of your LM Studio server (no trailing /v1 in LM_STUDIO_URL;
# LMSTUDIO_URL is the alias some components use — set both to the same value)
LM_STUDIO_URL=http://127.0.0.1:1234
LMSTUDIO_URL=http://127.0.0.1:1234
# API key for LM Studio (only needed if your LM Studio server requires auth)
LM_STUDIO_KEY=
LMSTUDIO_API_KEY=
LMSTUDIO_KEY=

# ─── Cloud providers ─────────────────────────────────────────────
MINIMAX_API_KEY=
OPENROUTER_API_KEY=

# ─── Agent Mesh (separate agent-mesh-api repo / mesh scripts) ────
AGENT_MESH_API_KEY=

# ─── Service ports ───────────────────────────────────────────────
# council-server.js — port is hardcoded to 3003 in the source
# council-api-server.cjs — PORT (default 3001)
PORT=3001
# webui/server.js — PORT (default 3131) and the council API it proxies to
# PORT=3131
COUNCIL_PORT=3001
COUNCIL_HOST=localhost
# council-test.js (minimal test server) — COUNCIL_PORT (default 3003)
# COUNCIL_PORT=3003

# ─── Optional integrations ───────────────────────────────────────
BRAVE_API_KEY=
BROWSEROS_MCP_URL=http://127.0.0.1:9000/mcp
MESH_URL=http://localhost:4000
LOG_LEVEL=INFO
