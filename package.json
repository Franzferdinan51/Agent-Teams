{
  "name": "agent-teams",
  "version": "2.2.2",
  "description": "Multi-Agent Collaboration System \u2014 The Hive Senate with 46 councilors, P2P mesh, live LLM deliberation, and hive mind intelligence",
  "main": "src/index.js",
  "scripts": {
    "test": "node test/run-tests.js",
    "start": "node src/index.js",
    "start:council": "node council-server.js",
    "start:webui": "node webui/server.js",
    "start:all": "./start-all.sh",
    "start:council-api": "node council-api-server.cjs",
    "start:mcp": "node mcp-server.js",
    "start:cli": "node council-cli.js",
    "council:status": "curl -s http://localhost:3003/api/health | jq .",
    "council:test": "curl -s -X POST http://localhost:3131/api/llm/test | jq .",
    "council:providers": "curl -s http://localhost:3003/api/providers | jq .",
    "council:deliberate": "curl -s -X POST http://localhost:3003/api/session/start -H \"Content-Type: application/json\" -d \"{\\\"topic\\\":\\\"Test deliberation\\\",\\\"mode\\\":\\\"proposal\\\"}\" | jq .",
    "council:list": "curl -s http://localhost:3003/api/councilors | jq \".councilors | length\"",
    "council:mcp-tools": "curl -s -X POST http://localhost:3001/mcp -H \"Content-Type: application/json\" -d \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"id\\\":1,\\\"method\\\":\\\"tools/list\\\"}\" | jq .",
    "council:cli": "node council-cli.js --help",
    "mcp:status": "curl -s http://localhost:3456/health | jq .",
    "mcp:tools": "curl -s -X POST http://localhost:3001/mcp -H \"Content-Type: application/json\" -d \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"id\\\":1,\\\"method\\\":\\\"tools/list\\\"}\" | jq ."
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "ws": "^8.23.0"
  },
  "peerDependencies": {},
  "keywords": [
    "multi-agent",
    "ai-council",
    "hive-mind",
    "collaboration",
    "coordination",
    "agent",
    "p2p",
    "decentralized",
    "federation",
    "deliberation"
  ],
  "author": "AgentTeams",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Franzferdinan51/Agent-Teams.git"
  }
}
